# Leave Supabase blank to run in demo mode (in-memory data, starts empty).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Homepage chat assistant model (default claude-opus-5-5 at low effort). claude-haiku-5-5 is far cheaper per message.
ANTHROPIC_CHAT_MODEL=
# Photo for "Jake", the homepage assistant: a stock photo URL you are licensed to use (or add public/jake.jpg).
NEXT_PUBLIC_ASSISTANT_AVATAR_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price per paid tier (monthly). Investor $49, Firm $149, Fund $399.
STRIPE_PRICE_INVESTOR=
STRIPE_PRICE_FIRM=
STRIPE_PRICE_FUND=
# Free-trial days on a first Investor or Firm subscription (default 7; 0 turns trials off).
STRIPE_TRIAL_DAYS=7
# Optional legacy single-tier price; if set, it maps to Investor.
STRIPE_PRICE_PRO_MONTHLY=
# Property data by address (beds, baths, sqft, taxes, value and rent estimates, comps, active listing).
# https://app.rentcast.io → API. Leave blank to hide "Pull property data".
RENTCAST_API_KEY=
# App-wide cap on RentCast API calls per calendar month (each new address uses up to 4; repeats are cached 30 days).
RENTCAST_MONTHLY_CALLS=50
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
