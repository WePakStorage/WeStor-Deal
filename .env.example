# Leave Supabase blank to run in demo mode (in-memory data, seeded sample deals).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price per paid tier (monthly). Investor $49, Firm $149, Fund $399.
STRIPE_PRICE_INVESTOR=
STRIPE_PRICE_FIRM=
STRIPE_PRICE_FUND=
# Legacy single-tier price from the WeStor build; if set, it maps to Investor.
STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_INBOUND_SECRET=
# Domain used for per-space inbound alert addresses, e.g. inbound.undriq.app
RESEND_INBOUND_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
