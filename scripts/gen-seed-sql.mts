// Generates supabase/migrations/*_seed_org.sql from lib/seed.ts so the SQL seed
// and the demo store never drift. Run: node scripts/gen-seed-sql.mts
import { writeFileSync } from "node:fs";
import { seedBuyers, seedDeals, seedFinancials, seedUnitMix } from "../lib/seed.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (typeof v === "boolean") return v ? "true" : "false";
  if (Array.isArray(v)) return `array[${v.map(q).join(",")}]::text[]`;
  if (typeof v === "object") return `'${JSON.stringify(v).replace(/'/g, "''")}'::jsonb`;
  return `'${String(v).replace(/'/g, "''")}'`;
};

const ORG = "00000000-0000-0000-0000-000000000000";
const deals = seedDeals(ORG);
const lines: string[] = [];
lines.push("-- GENERATED by scripts/gen-seed-sql.mts. Do not edit by hand.");
lines.push("create or replace function public.seed_org(target uuid) returns void");
lines.push("language plpgsql security definer set search_path = public as $$");
lines.push("declare");
deals.forEach((_, i) => lines.push(`  d${i} uuid := gen_random_uuid();`));
lines.push("begin");
const dealCols = ["name","market_city","market_state","address","property_type","units","nrsf","acres","buildings","year_built","physical_occupancy","list_price","target_price","appraised_value","appraisal_date","stage","contract_signed_at","contract_price","assignable","notes","is_sample","construction","sources"] as const;
deals.forEach((d, i) => {
  lines.push(`  insert into deals(id, org_id, ${dealCols.join(", ")}) values (d${i}, target, ${dealCols.map((c) => q(d[c])).join(", ")});`);
});
const idx = (dealId: string) => deals.findIndex((d) => d.id === dealId);
for (const f of seedFinancials()) {
  lines.push(`  insert into deal_financials(org_id, deal_id, period, period_label, potential_rent, vacancy, other_income, egi, expenses, total_expenses, noi, source) values (target, d${idx(f.deal_id)}, ${[f.period, f.period_label, f.potential_rent, f.vacancy, f.other_income, f.egi, f.expenses, f.total_expenses, f.noi, f.source].map(q).join(", ")});`);
}
for (const u of seedUnitMix()) {
  lines.push(`  insert into unit_mix(org_id, deal_id, unit_type, width, depth, count, occupied, street_rent, in_place_rent, climate) values (target, d${idx(u.deal_id)}, ${[u.unit_type, u.width, u.depth, u.count, u.occupied, u.street_rent, u.in_place_rent, u.climate].map(q).join(", ")});`);
}
for (const b of seedBuyers(ORG)) {
  lines.push(`  insert into buyers(org_id, firm_name, contact_name, email, phone, buyer_type, accepts_assignment, states, min_price, max_price, min_nrsf, max_nrsf, property_types, strategy, financing, notes) values (target, ${[b.firm_name, b.contact_name, b.email, b.phone, b.buyer_type, b.accepts_assignment, b.states, b.min_price, b.max_price, b.min_nrsf, b.max_nrsf, b.property_types, b.strategy, b.financing, b.notes].map(q).join(", ")});`);
}
lines.push("end $$;");
lines.push("");
writeFileSync("supabase/migrations/20261104000002_seed_org.sql", lines.join("\n"));
console.log("wrote seed_org migration");
